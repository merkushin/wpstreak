#. Description of the plugin
#: writing-streak.php
msgid "Shows your current writing streak above the Posts list."
msgstr "Показывает вашу текущую серию публикаций над списком записей."

#: src/views/streak_panel.php:26
msgid "Start your next streak"
msgstr "Начните новую серию"

#: src/views/streak_panel.php:28
msgid "You are on fire today"
msgstr "Сегодня вы в ударе"

#: src/views/streak_panel.php:30
msgid "You are still alive, publish today to keep it going"
msgstr "Серия ещё жива — опубликуйте запись сегодня, чтобы её продолжить"

#: src/views/streak_panel.php:21
msgid "Writing momentum"
msgstr "Писательский ритм"

#: src/views/streak_panel.php:22
msgid "Protect the streak. Build the habit."
msgstr "Берегите серию. Вырабатывайте привычку."

#: src/views/streak_panel.php:36
msgid "Current run"
msgstr "Текущая серия"

#. translators: %s: Number of days.
#: src/views/streak_panel.php:40
#: src/views/streak_panel.php:53
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s день"
msgstr[1] "%s дня"
msgstr[2] "%s дней"

#: src/views/streak_panel.php:45
msgid "Last published"
msgstr "Последняя публикация"

#: src/views/streak_panel.php:46
msgid "No published posts yet"
msgstr "Опубликованных записей пока нет"

#: src/views/streak_panel.php:49
msgid "Next milestone"
msgstr "Следующая цель"

#. translators: Unit shown after the large streak number, e.g. "12 days".
#: src/views/streak_panel.php:66
msgctxt "streak counter unit"
msgid "day"
msgid_plural "days"
msgstr[0] "день"
msgstr[1] "дня"
msgstr[2] "дней"

#: src/views/streak_panel.php:72
msgid "Published today"
msgstr "Опубликовано сегодня"

#: src/views/streak_panel.php:72
msgid "Needs a post today"
msgstr "Сегодня нужна запись"

#: src/views/streak_panel.php:77
msgid "Milestone progress"
msgstr "Прогресс к цели"

#. translators: %s: Progress towards the next milestone, a number from 0 to 100.
#: src/views/streak_panel.php:81
#, php-format
msgid "%s%%"
msgstr "%s%%"

