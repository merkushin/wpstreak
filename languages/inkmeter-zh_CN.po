#. Plugin Name of the plugin
#: inkmeter.php src/Pro/SettingsPage.php:167 src/Pro/SettingsPage.php:168
#: src/views/screen_option.php:11 src/views/settings_page.php:26
msgid "Inkmeter"
msgstr "Inkmeter"

#. Plugin URI of the plugin
#: inkmeter.php
msgid "https://github.com/merkushin/inkmeter"
msgstr "https://github.com/merkushin/inkmeter"

#. Description of the plugin
#: inkmeter.php
msgid "Shows your current writing streak above the Posts list."
msgstr "在文章列表上方显示您当前的连续写作天数。"

#. Author of the plugin
#: inkmeter.php
msgid "Dmitry Merkushin"
msgstr "Dmitry Merkushin"

#: src/Pro/SettingsPage.php:359
msgid "Your site is connected to Inkmeter."
msgstr "您的站点已连接到 Inkmeter。"

#: src/Pro/SettingsPage.php:360
msgid ""
"Your site is disconnected from Inkmeter. Your streak history is kept in your "
"account."
msgstr "您的站点已与 Inkmeter 断开连接。您的连续记录历史仍保存在您的账户中。"

#: src/Pro/SettingsPage.php:361
msgid "Reminder settings saved."
msgstr "提醒设置已保存。"

#: src/Pro/SettingsPage.php:362
msgid "Connecting didn't work. The link may have expired; please try again."
msgstr "连接失败。链接可能已过期，请重试。"

#: src/Pro/SettingsPage.php:363
msgid ""
"This site is no longer connected to Inkmeter. Connect it again to keep using "
"Pro."
msgstr "此站点已不再连接到 Inkmeter。请重新连接以继续使用 Pro。"

#: src/Pro/SettingsPage.php:364
msgid "Inkmeter couldn't be reached. Please try again in a minute."
msgstr "无法连接到 Inkmeter。请稍后再试。"

#: src/Pro/SettingsPage.php:365
msgid "Billing isn't available right now. Please try again later."
msgstr "付款功能目前不可用。请稍后再试。"

#: src/Pro/SettingsPage.php:366
msgid "Something went wrong. Please try again."
msgstr "出了点问题，请重试。"

#: src/Pro/SettingsPage.php:432
msgid "Sorry, you are not allowed to manage Inkmeter."
msgstr "抱歉，您不能管理 Inkmeter。"

#: src/views/screen_option.php:14
msgid "Writing streak panel"
msgstr "连续写作面板"

#: src/views/settings_page.php:33
msgid "Inkmeter Pro"
msgstr "Inkmeter Pro"

#: src/views/settings_page.php:34
msgid "Never lose a streak by accident. With Inkmeter Pro:"
msgstr "再也不会意外中断连续记录。使用 Inkmeter Pro："

#: src/views/settings_page.php:36
msgid ""
"You get an email at the hour you choose when you haven't published yet that "
"day."
msgstr "如果您当天还没有发布，会在您选择的时间收到一封电子邮件。"

#: src/views/settings_page.php:37
msgid ""
"Your streak history is kept in your Inkmeter account, so it survives "
"reinstalls and site moves."
msgstr ""
"您的连续记录历史保存在您的 Inkmeter 账户中，即使重新安装插件或迁移站点也不会"
"丢失。"

#. translators: %s: Link to Inkmeter's privacy policy.
#: src/views/settings_page.php:43
#, php-format
msgid ""
"Connecting sends Inkmeter this site's address, its timezone and the dates "
"you published on, never your posts. Nothing is sent until you connect. %s"
msgstr ""
"连接后，Inkmeter 会收到此站点的地址、时区以及您发布文章的日期，但绝不会收到您"
"的文章内容。在您连接之前，不会发送任何数据。%s"

#: src/views/settings_page.php:44
msgid "Privacy policy"
msgstr "隐私政策"

#: src/views/settings_page.php:51
msgid "Connect to Inkmeter"
msgstr "连接到 Inkmeter"

#: src/views/settings_page.php:55
msgid ""
"Inkmeter couldn't be reached, so some details are missing. Please reload the "
"page in a minute."
msgstr "无法连接到 Inkmeter，因此部分信息缺失。请稍后重新加载页面。"

#: src/views/settings_page.php:60
msgid "Account"
msgstr "账户"

#: src/views/settings_page.php:64
msgid "Plan"
msgstr "方案"

#: src/views/settings_page.php:65
msgid "Pro"
msgstr "Pro"

#: src/views/settings_page.php:65
msgid "Free"
msgstr "免费"

#: src/views/settings_page.php:69
msgid "Streak in your account"
msgstr "账户中的连续记录"

#. translators: %s: Number of days.
#: src/views/settings_page.php:73 src/views/streak_panel.php:45
#: src/views/streak_panel.php:58
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s 天"

#: src/views/settings_page.php:79
msgid "Last synced"
msgstr "上次同步"

#: src/views/settings_page.php:83
msgid "Not yet"
msgstr "尚未同步"

#. translators: %s: Time since the last sync, e.g. "5 mins".
#: src/views/settings_page.php:86
#, php-format
msgid "%s ago"
msgstr "%s前"

#: src/views/settings_page.php:94
msgid "Reminders"
msgstr "提醒"

#: src/views/settings_page.php:100
msgid "Email reminder"
msgstr "电子邮件提醒"

#. translators: %s: Account email address.
#: src/views/settings_page.php:106
#, php-format
msgid "Email %s when I haven't published yet"
msgstr "当我还没有发布时，发送电子邮件至 %s"

#: src/views/settings_page.php:112
msgid "Send it at"
msgstr "发送时间"

#. translators: %s: The site's timezone, e.g. "America/Mexico_City".
#: src/views/settings_page.php:120
#, php-format
msgid "In your site's timezone (%s)."
msgstr "使用您站点的时区（%s）。"

#: src/views/settings_page.php:126
msgid "Save reminders"
msgstr "保存提醒"

#: src/views/settings_page.php:132
msgid "Manage subscription"
msgstr "管理订阅"

#: src/views/settings_page.php:135 src/views/settings_page.php:140
msgid "Upgrade to Pro"
msgstr "升级到 Pro"

#: src/views/settings_page.php:136
msgid ""
"Get an email at the hour you choose when you haven't published yet that day."
msgstr "如果您当天还没有发布，可在您选择的时间收到一封电子邮件。"

#: src/views/settings_page.php:144 src/views/settings_page.php:154
msgid "Disconnect"
msgstr "断开连接"

#. translators: %s: This site's address.
#: src/views/settings_page.php:148
#, php-format
msgid ""
"Stops sending %s's publishing days to Inkmeter. Your streak history stays in "
"your account, and connecting again picks it up."
msgstr ""
"停止向 Inkmeter 发送 %s 的发布日期。您的连续记录历史将保留在您的账户中，重新"
"连接后即可继续。"

#: src/views/streak_panel.php:23
msgid "Writing momentum"
msgstr "写作势头"

#: src/views/streak_panel.php:24
msgid "Protect the streak. Build the habit."
msgstr "守住连续记录，养成写作习惯。"

#: src/views/streak_panel.php:28
msgid "Start your next streak"
msgstr "开始新的连续写作"

#: src/views/streak_panel.php:30
msgid "You are on fire today"
msgstr "今天状态火热"

#: src/views/streak_panel.php:32
msgid "You are still alive, publish today to keep it going"
msgstr "连续记录仍在继续，今天发布即可延续"

#: src/views/streak_panel.php:37
msgid "Get an email before your streak breaks"
msgstr "在连续记录中断前收到电子邮件提醒"

#: src/views/streak_panel.php:41
msgid "Current run"
msgstr "当前连续"

#: src/views/streak_panel.php:50
msgid "Last published"
msgstr "最近发布"

#: src/views/streak_panel.php:51
msgid "No published posts yet"
msgstr "还没有已发布的文章"

#: src/views/streak_panel.php:54
msgid "Next milestone"
msgstr "下一个里程碑"

#. translators: Unit shown after the large streak number, e.g. "12 days".
#: src/views/streak_panel.php:71
msgctxt "streak counter unit"
msgid "day"
msgid_plural "days"
msgstr[0] "天"

#: src/views/streak_panel.php:77
msgid "Published today"
msgstr "今天已发布"

#: src/views/streak_panel.php:77
msgid "Needs a post today"
msgstr "今天还需发布"

#: src/views/streak_panel.php:82
msgid "Milestone progress"
msgstr "里程碑进度"

#. translators: %s: Progress towards the next milestone, a number from 0 to 100.
#: src/views/streak_panel.php:86
#, php-format
msgid "%s%%"
msgstr "%s%%"
