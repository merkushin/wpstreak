#. Plugin Name of the plugin
#: wpstreak.php
msgid "WP Streak"
msgstr "WP Streak"

#. Description of the plugin
#: wpstreak.php
msgid "Shows your current writing streak above the Posts list."
msgstr "Mostra sua sequência de escrita atual acima da lista de posts."

#: src/views/streak_panel.php:20
msgid "Start your next streak"
msgstr "Comece sua próxima sequência"

#: src/views/streak_panel.php:21
msgid "You are on fire today"
msgstr "Você está pegando fogo hoje"

#: src/views/streak_panel.php:22
msgid "You are still alive, publish today to keep it going"
msgstr "Sua sequência continua viva, publique hoje para mantê-la"

#: src/views/streak_panel.php:27
msgid "Writing momentum"
msgstr "Ritmo de escrita"

#: src/views/streak_panel.php:28
msgid "Protect the streak. Build the habit."
msgstr "Proteja a sequência. Crie o hábito."

#: src/views/streak_panel.php:32
msgid "Current run"
msgstr "Sequência atual"

#. translators: %s: Number of days.
#: src/views/streak_panel.php:36
#: src/views/streak_panel.php:49
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s dia"
msgstr[1] "%s dias"

#: src/views/streak_panel.php:41
msgid "Last published"
msgstr "Última publicação"

#: src/views/streak_panel.php:42
msgid "No published posts yet"
msgstr "Nenhum post publicado ainda"

#: src/views/streak_panel.php:45
msgid "Next milestone"
msgstr "Próxima meta"

#. translators: Unit shown after the large streak number, e.g. "12 days".
#: src/views/streak_panel.php:62
msgctxt "streak counter unit"
msgid "day"
msgid_plural "days"
msgstr[0] "dia"
msgstr[1] "dias"

#: src/views/streak_panel.php:68
msgid "Published today"
msgstr "Publicado hoje"

#: src/views/streak_panel.php:68
msgid "Needs a post today"
msgstr "Falta um post hoje"

#: src/views/streak_panel.php:73
msgid "Milestone progress"
msgstr "Progresso da meta"

#. translators: %s: Progress towards the next milestone, a number from 0 to 100.
#: src/views/streak_panel.php:77
#, php-format
msgid "%s%%"
msgstr "%s%%"
