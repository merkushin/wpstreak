#. Description of the plugin
#: inkmeter.php
msgid "Shows your current writing streak above the Posts list."
msgstr "投稿一覧の上に現在の執筆ストリークを表示します。"

#: src/views/streak_panel.php:27
msgid "Start your next streak"
msgstr "次のストリークを始めましょう"

#: src/views/streak_panel.php:29
msgid "You are on fire today"
msgstr "今日は絶好調です"

#: src/views/streak_panel.php:31
msgid "You are still alive, publish today to keep it going"
msgstr "ストリーク継続中です。今日投稿して記録をつなげましょう"

#: src/views/streak_panel.php:22
msgid "Writing momentum"
msgstr "執筆の勢い"

#: src/views/streak_panel.php:23
msgid "Protect the streak. Build the habit."
msgstr "ストリークを守り、習慣を作りましょう。"

#: src/views/streak_panel.php:37
msgid "Current run"
msgstr "現在の連続記録"

#. translators: %s: Number of days.
#: src/views/streak_panel.php:41
#: src/views/streak_panel.php:54
#, php-format
msgid "%s day"
msgid_plural "%s days"
msgstr[0] "%s日"

#: src/views/streak_panel.php:46
msgid "Last published"
msgstr "最終公開日"

#: src/views/streak_panel.php:47
msgid "No published posts yet"
msgstr "公開済みの投稿はまだありません"

#: src/views/streak_panel.php:50
msgid "Next milestone"
msgstr "次の目標"

#. translators: Unit shown after the large streak number, e.g. "12 days".
#: src/views/streak_panel.php:67
msgctxt "streak counter unit"
msgid "day"
msgid_plural "days"
msgstr[0] "日"

#: src/views/streak_panel.php:73
msgid "Published today"
msgstr "今日公開済み"

#: src/views/streak_panel.php:73
msgid "Needs a post today"
msgstr "今日の投稿が必要です"

#: src/views/streak_panel.php:78
msgid "Milestone progress"
msgstr "目標までの進捗"

#. translators: %s: Progress towards the next milestone, a number from 0 to 100.
#: src/views/streak_panel.php:82
#, php-format
msgid "%s%%"
msgstr "%s%%"

#. Plugin URI of the plugin
#: inkmeter.php
msgid "https://github.com/merkushin/inkmeter"
msgstr "https://github.com/merkushin/inkmeter"

#. Author of the plugin
