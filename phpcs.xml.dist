<?xml version="1.0"?>
<ruleset name="Inkmeter">
	<description>Coding standards for Inkmeter.</description>

	<file>inkmeter.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>
	<file>bin</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- WordPress.org targets: PHP 7.4+ and WordPress 6.2+. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="inkmeter"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="inkmeter"/>
				<element value="Merkushin\Inkmeter"/>
			</property>
		</properties>
	</rule>

	<!-- Classes follow PSR-4 (src/Streak.php), not WordPress' class-streak.php naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- The codebase uses short array syntax. -->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Tests and build scripts (bin/) don't run inside WordPress: PHPUnit's test namespace,
	     stubs of WordPress functions, CLI globals and plain file functions are fine there. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>tests/stubs/*</exclude-pattern>
		<exclude-pattern>tests/smoke/*</exclude-pattern>
	</rule>
	<!-- The smoke test replaces $wpdb with a fake, and CLI scripts print plain text, not HTML. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/smoke/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>tests/smoke/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>
</ruleset>
